NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional billing provider. Configure the complete server-side set or leave all blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_RECONCILIATION_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional providers. Current delivery adapters support disabled or local console mode.
OPENAI_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Transactional notification outbox. Generate the encryption key with:
# openssl rand -base64 32
NOTIFICATION_LINK_ENCRYPTION_KEY=
NOTIFICATION_CRON_SECRET=
# disabled (default) or console (development only)
EMAIL_PROVIDER=disabled
SMS_PROVIDER=disabled

# Test-only browser settings. Never configure these on a production service.
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_AUTHENTICATED=1
# PLAYWRIGHT_CHROME_PATH=/path/to/local/chrome

# Test-only QA personas. Local Supabase has safe built-in fixture credentials;
# remote development projects require explicit values and all three seed guards.
# QA_AUTOMOTIVE_OWNER_EMAIL=
# QA_SALON_OWNER_EMAIL=
# QA_OWNER_PASSWORD=
# QA_SEED_TARGET=development
# QA_SEED_ALLOW_REMOTE_DEVELOPMENT=true
# QA_SEED_CONFIRM=NEGOSU_NON_PRODUCTION_QA_ONLY

# PayMongo prepaid account plans. Only enable payment methods activated on your account.
# Use sk_test_... in development and sk_live_... in production. Never expose these in NEXT_PUBLIC variables.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHOD_TYPES=gcash,qrph,card

# Comma-separated Supabase Auth user UUIDs allowed to access /admin. Empty disables access.
# Server-only. Tenant ownership and editable user metadata never grant platform access.
PLATFORM_ADMIN_USER_IDS=
